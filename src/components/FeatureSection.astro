---
interface Highlight {
  title?: string;
  body?: string;
}

interface StoryImage {
  image?: string;
  alt?: string;
}

interface Props {
  title: string;
  body: string;
  highlights: Highlight[];
  storyImages?: StoryImage[];
}

const { title, body, highlights, storyImages = [] } = Astro.props;
const visibleHighlights = highlights.filter((item) => item.title || item.body);
const visibleImages = storyImages.filter((item) => item.image);
const hasSectionContent = Boolean(title || body || visibleHighlights.length > 0 || visibleImages.length > 0);
---

{hasSectionContent && (
  <section id="story" class="feature-section section-padding">
    <div class="container grid-layout">
      <div class="left-col">
        {(title || body) && (
          <div class="intro-content fade-in-up">
            {title && <h2 class="section-title">{title}</h2>}
            {body && <p class="section-body prose">{body}</p>}
          </div>
        )}

        {visibleHighlights.length > 0 && (
          <div class="highlights-grid mobile-only">
            {visibleHighlights.map((item, index) => (
              <div class="highlight-card fade-in-up" style={`transition-delay: ${index * 100}ms`}>
                <div class="card-number">0{index + 1}</div>
                {item.title && <h3 class="card-title">{item.title}</h3>}
                {item.body && <p class="card-body">{item.body}</p>}
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="right-col">
        {visibleImages.length > 0 && (
          <div class="story-images fade-in-up">
            {visibleImages.map((img) => (
              <div class="story-image-wrap">
                <img src={img.image} alt={img.alt || ''} loading="lazy" />
              </div>
            ))}
          </div>
        )}

        {visibleHighlights.length > 0 && (
          <div class="highlights-grid desktop-only">
            {visibleHighlights.map((item, index) => (
              <div class="highlight-card fade-in-up" style={`transition-delay: ${index * 100}ms`}>
                <div class="card-number">0{index + 1}</div>
                {item.title && <h3 class="card-title">{item.title}</h3>}
                {item.body && <p class="card-body">{item.body}</p>}
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .grid-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
    gap: 5rem;
    align-items: start;
  }

  .section-title {
    font-size: clamp(2.4rem, 6vw, 4.8rem);
    margin-bottom: 2rem;
    color: var(--color-text);
    letter-spacing: 0;
  }

  .section-body {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    max-width: 34rem;
    line-height: 2;
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .left-col .highlights-grid {
    margin-top: 3rem;
  }

  .right-col .highlights-grid {
    margin-top: 0;
  }

  .right-col {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .mobile-only {
    display: none;
  }

  .desktop-only {
    display: grid;
  }

  .highlight-card {
    padding: 2rem;
    background: rgba(255, 255, 255, 0.68);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    transition: var(--transition-smooth);
  }

  .highlight-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary);
    box-shadow: 0 18px 38px rgba(64, 82, 69, 0.08);
  }

  .card-number {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 1.5rem;
    display: block;
  }

  .card-title {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .card-body {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  .prose {
    white-space: pre-line;
  }

  .story-images {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    align-items: stretch;
  }

  .story-image-wrap {
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .story-image-wrap:nth-child(1) {
    grid-row: span 2;
    aspect-ratio: 3 / 4;
  }

  .story-image-wrap:nth-child(2),
  .story-image-wrap:nth-child(3) {
    aspect-ratio: 4 / 3;
  }

  .story-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .story-image-wrap:hover img {
    transform: scale(1.04);
  }

  @media (max-width: 1024px) {
    .grid-layout {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
    .story-images {
      grid-template-columns: repeat(3, 1fr);
      margin-top: 2rem;
    }
    .story-image-wrap:nth-child(1) {
      grid-row: auto;
      aspect-ratio: 4 / 3;
    }
    .mobile-only {
      display: grid;
    }
    .desktop-only {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .highlights-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Intersection Observer class will trigger these */
  .fade-in-up {
    opacity: 1;
    transform: translateY(0);
  }
</style>
