---
interface Props {
  locale?: string;
  copy?: {
    title?: string;
    subtitle?: string;
    nameLabel?: string;
    namePlaceholder?: string;
    countryLabel?: string;
    countryPlaceholder?: string;
    countryOptions?: string[];
    whatsappLabel?: string;
    whatsappPlaceholder?: string;
    typeLabel?: string;
    typeOptions?: string[];
    brandLabel?: string;
    brandPlaceholder?: string;
    emailLabel?: string;
    emailPlaceholder?: string;
    submitLabel?: string;
  };
  messages?: {
    sending?: string;
    success?: string;
    error?: string;
    networkError?: string;
  };
}

const { locale = 'en', copy, messages } = Astro.props;

const defaultCountryOptions = ['Canada', 'USA', 'Other'];
const defaultTypeOptions = ['Dealer', 'Individual'];
const countryOptions = copy?.countryOptions?.length ? copy.countryOptions : defaultCountryOptions;
const typeOptions = copy?.typeOptions?.length ? copy.typeOptions : defaultTypeOptions;

const t = {
  sending: messages?.sending || 'Sending...',
  success: messages?.success || 'Thank you! We will get back to you within 24 hours.',
  error: messages?.error || 'Submission failed. Please try again later.',
  networkError: messages?.networkError || 'Network error. Please try again later.',
};
const contactFormEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT || '/api/contact';
---

<section class="contact-form-section">
  <div class="container">
    <div class="contact-form-card">
      {(copy?.title || copy?.subtitle) && (
        <div class="form-header">
          {copy?.title && <h2 class="form-title">{copy.title}</h2>}
          {copy?.subtitle && <p class="form-subtitle">{copy.subtitle}</p>}
        </div>
      )}
      <form id="contact-form" class="contact-form" novalidate>
        <div class="form-grid">
          <div class="form-group">
            <label for="contact-name">{copy?.nameLabel || 'Name'}</label>
            <input type="text" id="contact-name" placeholder={copy?.namePlaceholder || 'Your name'} required />
          </div>
          <div class="form-group">
            <label for="contact-country">{copy?.countryLabel || 'Country'}</label>
            <select id="contact-country" required>
              <option value="">{copy?.countryPlaceholder || 'Select country'}</option>
              {countryOptions.map((option) => <option value={option}>{option}</option>)}
            </select>
          </div>
          <div class="form-group">
            <label for="contact-whatsapp">{copy?.whatsappLabel || 'WhatsApp'}</label>
            <input type="text" id="contact-whatsapp" placeholder={copy?.whatsappPlaceholder || 'Your WhatsApp number'} required />
          </div>
          <div class="form-group">
            <label for="contact-type">{copy?.typeLabel || 'Type'}</label>
            <select id="contact-type" required>
              <option value="">Select</option>
              {typeOptions.map((option) => <option value={option}>{option}</option>)}
            </select>
          </div>
          <div class="form-group">
            <label for="contact-brand">{copy?.brandLabel || 'Car Brand'}</label>
            <input type="text" id="contact-brand" placeholder={copy?.brandPlaceholder || 'e.g. BYD, Toyota'} required />
          </div>
          <div class="form-group">
            <label for="contact-email">{copy?.emailLabel || 'Email'}</label>
            <input type="email" id="contact-email" placeholder={copy?.emailPlaceholder || 'Your email'} required />
          </div>
        </div>
        <button type="submit" class="btn btn-primary submit-btn" id="contact-submit-btn">
          {copy?.submitLabel || 'Submit'}
        </button>
        <div id="contact-status" class="contact-status" aria-live="polite"></div>
      </form>
    </div>
  </div>
</section>

<script is:inline define:vars={{ t, contactFormEndpoint }}>
  document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget;
    const status = document.getElementById('contact-status');
    const btn = document.getElementById('contact-submit-btn');
    if (!status || !btn) return;
    const originalLabel = btn.textContent;

    const data = {
      name: document.getElementById('contact-name')?.value || '',
      country: document.getElementById('contact-country')?.value || '',
      whatsapp: document.getElementById('contact-whatsapp')?.value || '',
      type: document.getElementById('contact-type')?.value || '',
      brand: document.getElementById('contact-brand')?.value || '',
      email: document.getElementById('contact-email')?.value || '',
    };

    btn.disabled = true;
    btn.textContent = `${t.sending}`;
    status.className = 'contact-status';
    status.textContent = '';

    try {
      const res = await fetch(contactFormEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const contentType = res.headers.get('content-type') || '';
      const result = contentType.includes('application/json')
        ? await res.json()
        : { ok: false, error: `${t.error}` };

      if (res.ok && result.ok) {
        status.className = 'contact-status contact-status-success';
        status.textContent = `${t.success}`;
        form.querySelectorAll('input, select').forEach((el) => {
          if (el.id !== 'contact-country' && el.id !== 'contact-type') el.value = '';
        });
      } else {
        status.className = 'contact-status contact-status-error';
        status.textContent = result.error || `${t.error}`;
      }
    } catch {
      status.className = 'contact-status contact-status-error';
      status.textContent = `${t.networkError}`;
    } finally {
      btn.disabled = false;
      btn.textContent = originalLabel;
    }
  });
</script>

<style>
  .contact-form-section {
    padding: 4rem 0;
  }

  .contact-form-card {
    background: white;
    padding: 3rem;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    max-width: 800px;
    margin: 0 auto;
  }

  .form-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .form-title {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .form-subtitle {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-size: 0.9rem;
    font-weight: 600;
  }

  .form-group input,
  .form-group select {
    padding: 0.8rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 1rem;
    transition: var(--transition-fast);
  }

  .form-group input:focus,
  .form-group select:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(0, 118, 214, 0.1);
  }

  .submit-btn {
    width: 100%;
    padding: 1rem;
    font-size: 1.1rem;
  }

  .submit-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .contact-status {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    display: none;
  }

  .contact-status-success {
    display: block;
    background: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .contact-status-error {
    display: block;
    background: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  @media (max-width: 768px) {
    .contact-form-card {
      padding: 2rem 1.5rem;
    }
    .form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
