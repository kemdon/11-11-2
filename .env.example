CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT_NAME=
# Pages production branch used by project creation and production deploys.
CLOUDFLARE_PAGES_PRODUCTION_BRANCH=main
# Optional production Pages hostname. When set, deploy waits for an active domain and valid public HTTP/HTTPS responses.
CLOUDFLARE_PAGES_CUSTOM_DOMAIN=
# Canonical production origin used by Astro SEO output. Deploy derives the confirmed Pages/custom-domain origin when this is empty.
PUBLIC_SITE_URL=
# auto: use a visible active Cloudflare zone, otherwise require an external public CNAME.
# cloudflare: require the zone in Cloudflare and allow DNS management when explicitly enabled.
# external: never call the Cloudflare DNS API; only verify the public CNAME.
CLOUDFLARE_PAGES_DNS_MODE=auto
# Optional explicit apex zone. Set this for multi-label public suffixes or when inference is ambiguous.
CLOUDFLARE_PAGES_DNS_ZONE_NAME=
# Explicitly opt in before deploy creates or changes the hostname's DNS record.
CLOUDFLARE_PAGES_MANAGE_DNS=false
# Optional comma-separated public resolvers used to bypass stale local DNS caches during verification.
CLOUDFLARE_PUBLIC_DNS_SERVERS=1.1.1.1,8.8.8.8,223.5.5.5

# Staging zone for preview deployments. This must match both the zone owned by
# the preview account and the PREVIEW_DOMAIN constant in preview-router/worker.js.
PREVIEW_DOMAIN=zhidaola.top
# Browser-visible preview base URL for the Keystatic admin "Preview" button.
# scripts/start-local.mjs overrides this with the actual bound local port.
PUBLIC_KEYSTATIC_PREVIEW_ORIGIN=http://127.0.0.1:4321

PUBLIC_ENABLE_SITE_ANALYTICS=false
PUBLIC_SITE_ANALYTICS_ENDPOINT=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Deployment shape of the site.
#
#   static   (default) -- Cloudflare Pages static assets only. The deployment is
#                         exactly dist/, with no Functions. This is the shape to
#                         reach for first, because moving the site to another
#                         Cloudflare account is then nothing but uploading dist/.
#   function           -- static assets plus functions/ (the Resend contact form).
#                         A Function has to be re-provisioned together with its
#                         secrets in every account the site is deployed to, so it
#                         is opt-in rather than the default.
#
# static + a functions/ directory is a contradiction and the deploy refuses it.
# Leave this unset and the mode is inferred from whether functions/ exists (and a
# notice is printed) -- set it explicitly so the shape is declared, not guessed.
CONTACT_FORM_MODE=static

# Contact form endpoint.
#   CONTACT_FORM_MODE=function -> keep the same-origin /api/contact
#   CONTACT_FORM_MODE=static   -> must be an absolute external URL; a static
#                                 deployment has no runtime to receive the POST
PUBLIC_CONTACT_FORM_ENDPOINT=/api/contact
PUBLIC_CONTACT_FORM_EMAIL=

# Required only when CONTACT_FORM_MODE=function.
# Cloudflare Pages Function email delivery. Store RESEND_API_KEY as an encrypted Pages secret.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_FORM_TO_EMAIL=
