---
interface ProductItem {
  name: string;
  description?: string;
  image?: string;
}

interface CategoryItem {
  id: string;
  name: string;
  englishName?: string;
  description?: string;
  mainImage?: string;
  products: ProductItem[];
}

interface Props {
  locale: string;
  label?: string;
  title?: string;
  body?: string;
  categories?: CategoryItem[];
}

const {
  locale,
  label = "Living Picks",
  title = "生活好物",
  body,
  categories = [],
} = Astro.props;
---

{categories.length > 0 && (
  <section id="picks" class="living-picks-section section-padding">
    <div class="container">
      <div class="picks-header fade-in-up">
        {label && <span class="section-kicker">{label}</span>}
        {title && <h2 class="section-title">{title}</h2>}
        {body && <p class="section-desc">{body}</p>}
      </div>

      <!-- Tab controller -->
      <div class="picks-tabs-nav fade-in-up" role="tablist">
        {categories.map((cat, idx) => (
          <button
            class={`tab-btn ${idx === 0 ? 'active' : ''}`}
            data-tab-target={`cat-${cat.id}`}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
            aria-controls={`panel-${cat.id}`}
          >
            <span class="tab-num">{cat.id}</span>
            <span class="tab-label">
              <span class="tab-zh">{locale === 'en' ? (cat.englishName || cat.name) : cat.name}</span>
            </span>
          </button>
        ))}
      </div>

      <!-- Tab contents -->
      <div class="picks-tabs-content">
        {categories.map((cat, idx) => (
          <div
            id={`panel-${cat.id}`}
            class={`tab-panel ${idx === 0 ? 'active' : ''}`}
            data-tab-panel={`cat-${cat.id}`}
            role="tabpanel"
          >
            <div class="category-showcase">
              <!-- Left: Big scene image and description -->
              <div class="scene-column reveal">
                <div class="scene-img-wrapper">
                  {cat.mainImage && (
                    <img src={cat.mainImage} alt={locale === 'en' ? (cat.englishName || cat.name) : cat.name} class="scene-image" />
                  )}
                  <div class="scene-overlay"></div>
                  <div class="scene-badge">{cat.englishName || 'Collection'}</div>
                </div>
                <div class="scene-info">
                  <h3 class="scene-title">{locale === 'en' ? (cat.englishName || cat.name) : cat.name}</h3>
                  {cat.description && <p class="scene-desc-text">{cat.description}</p>}
                </div>
              </div>

              <!-- Right: Grid of single product cards -->
              <div class="products-column">
                <h4 class="column-subtitle">{locale === 'en' ? 'Featured Items' : locale === 'zh-TW' ? '精選選品' : '精选选品'}</h4>
                <div class="product-cards-grid">
                  {cat.products.map((prod) => (
                    <div class="product-mini-card glass-effect">
                      <div class="prod-img-box">
                        {prod.image && (
                          <img src={prod.image} alt={prod.name} class="prod-mini-img" />
                        )}
                      </div>
                      <div class="prod-info-box">
                        <h5 class="prod-name">{prod.name}</h5>
                        {prod.description && <p class="prod-desc">{prod.description}</p>}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<script>
  function initTabs() {
    const tabButtons = document.querySelectorAll('[data-tab-target]');
    const tabPanels = document.querySelectorAll('[data-tab-panel]');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-tab-target');

        // Deactivate all buttons
        tabButtons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });

        // Hide all panels
        tabPanels.forEach((p) => {
          p.classList.remove('active');
        });

        // Activate clicked
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        const activePanel = document.querySelector(`[data-tab-panel="${target}"]`);
        if (activePanel) {
          activePanel.classList.add('active');
        }
      });
    });
  }

  // Initialize on page load and dynamic mounts
  initTabs();
  document.addEventListener('astro:after-swap', initTabs);
</script>

<style>
  .living-picks-section {
    background: #fbfbf9;
    border-top: 1px solid rgba(34, 54, 48, 0.05);
    position: relative;
    padding-block: 8rem;
  }

  .picks-header {
    max-width: 42rem;
    margin-bottom: 4.5rem;
  }

  .picks-tabs-nav {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    padding-bottom: 1.5rem;
    margin-bottom: 4rem;
    border-bottom: 1px solid rgba(34, 54, 48, 0.08);
    -scrollbar-width: none;
  }

  .picks-tabs-nav::-webkit-scrollbar {
    display: none;
  }

  .tab-btn {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1rem 2rem;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    border-radius: var(--radius-md);
    transition: var(--transition-smooth);
    white-space: nowrap;
    opacity: 0.5;
  }

  .tab-btn:hover {
    opacity: 0.85;
    background: rgba(34, 54, 48, 0.02);
  }

  .tab-btn.active {
    opacity: 1;
    background: rgba(34, 54, 48, 0.04);
  }

  .tab-num {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-primary);
  }

  .tab-label {
    display: flex;
    flex-direction: column;
  }

  .tab-zh {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .tab-en {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Panels */
  .tab-panel {
    display: none;
  }

  .tab-panel.active {
    display: block;
    animation: fade-in 0.5s ease;
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .category-showcase {
    display: grid;
    grid-template-columns: 1.1fr 1.3fr;
    gap: 5rem;
    align-items: start;
  }

  /* Scene Column */
  .scene-column {
    display: grid;
    gap: 2rem;
  }

  .scene-img-wrapper {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    box-shadow: 0 20px 40px rgba(34, 54, 48, 0.04);
  }

  .scene-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }

  .scene-img-wrapper:hover .scene-image {
    transform: scale(1.05);
  }

  .scene-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(34, 54, 48, 0.3), transparent);
  }

  .scene-badge {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(5px);
    padding: 0.4rem 0.9rem;
    border-radius: 2rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-primary-dark);
    text-transform: uppercase;
  }

  .scene-info {
    display: grid;
    gap: 0.75rem;
  }

  .scene-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .scene-desc-text {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  /* Products Column */
  .products-column {
    display: grid;
    gap: 2rem;
  }

  .column-subtitle {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-left: 2px solid var(--color-primary);
    padding-left: 0.75rem;
    line-height: 1;
  }

  .product-cards-grid {
    display: grid;
    gap: 1.25rem;
  }

  .product-mini-card {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem;
    background: white;
    border: 1px solid rgba(34, 54, 48, 0.05);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 15px rgba(34, 54, 48, 0.01);
    transition: var(--transition-smooth);
  }

  .product-mini-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(34, 54, 48, 0.04);
    border-color: rgba(34, 54, 48, 0.12);
  }

  .prod-img-box {
    flex-shrink: 0;
    width: 5rem;
    height: 5rem;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: #fbfbf9;
    border: 1px solid rgba(34, 54, 48, 0.04);
  }

  .prod-mini-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .prod-info-box {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
  }

  .prod-name {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .prod-desc {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  @media (max-width: 960px) {
    .category-showcase {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
  }

  @media (max-width: 640px) {
    .living-picks-section {
      padding-block: 5rem;
    }
    
    .product-mini-card {
      flex-direction: column;
      gap: 1rem;
    }
    
    .prod-img-box {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }
</style>
